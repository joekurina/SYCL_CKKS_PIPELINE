{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpt2026.local/schemas/experiment-status.schema.json",
  "title": "FPT 2026 terminal experiment status",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolute_path": {"type": "string", "pattern": "^/"},
    "quantity": {
      "type": "object",
      "required": ["value", "unit", "unavailable_reason"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "unavailable_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"value": {"type": "null"}}}, "then": {"properties": {"unavailable_reason": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"value": {"type": "number"}}}, "then": {"properties": {"unavailable_reason": {"type": "null"}}}}
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "record_type", "run_id", "experiment_id", "status", "effective_plan_sha256", "validated_counts", "evidence_sha256s", "reason", "finished_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "experiment_status"},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "pattern": "^E[1-8]$"},
    "status": {"enum": ["pass", "fail", "blocked", "not_run"]},
    "effective_plan_sha256": {"$ref": "#/$defs/sha256"},
    "validated_counts": {
      "type": "object",
      "required": ["attempts", "samples", "frames", "events", "correctness"],
      "properties": {
        "attempts": {"type": "integer", "minimum": 0},
        "samples": {"type": "integer", "minimum": 0},
        "frames": {"type": "integer", "minimum": 0},
        "events": {"type": "integer", "minimum": 0},
        "correctness": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "evidence_sha256s": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
    "report_evidence": {
      "type": "object",
      "required": ["report_root_path", "report_tree_sha256", "info_ndjson_path", "info_ndjson_sha256", "quartus_ndjson_path", "quartus_ndjson_sha256", "source_revision", "device_image_sha256", "fpga_target", "fitter_seed", "kernel_clock_mhz", "resources"],
      "properties": {
        "report_root_path": {"$ref": "#/$defs/absolute_path"},
        "report_tree_sha256": {"$ref": "#/$defs/sha256"},
        "info_ndjson_path": {"$ref": "#/$defs/absolute_path"},
        "info_ndjson_sha256": {"$ref": "#/$defs/sha256"},
        "quartus_ndjson_path": {"$ref": "#/$defs/absolute_path"},
        "quartus_ndjson_sha256": {"$ref": "#/$defs/sha256"},
        "source_revision": {"type": "string", "minLength": 7},
        "device_image_sha256": {"$ref": "#/$defs/sha256"},
        "fpga_target": {"const": "AGFB027R25A2E2V"},
        "fitter_seed": {"const": 7},
        "kernel_clock_mhz": {"type": "number", "exclusiveMinimum": 0},
        "resources": {
          "type": "object",
          "required": ["alut", "registers", "alm", "dsp", "ram"],
          "properties": {
            "alut": {"type": "integer", "minimum": 0},
            "registers": {"type": "integer", "minimum": 0},
            "alm": {"type": "integer", "minimum": 0},
            "dsp": {"type": "integer", "minimum": 0},
            "ram": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "child_output_path": {"$ref": "#/$defs/absolute_path"},
    "child_output_sha256": {"$ref": "#/$defs/sha256"},
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_path", "source_sha256", "locator", "parameter_set", "operation_boundary", "platform", "frequency", "latency", "throughput", "classification"],
        "properties": {
          "source_path": {"$ref": "#/$defs/absolute_path"},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "locator": {"type": "string", "minLength": 1},
          "parameter_set": {"type": "object"},
          "operation_boundary": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "frequency": {"$ref": "#/$defs/quantity"},
          "latency": {"$ref": "#/$defs/quantity"},
          "throughput": {"$ref": "#/$defs/quantity"},
          "classification": {"enum": ["measured", "modeled", "quoted"]}
        },
        "additionalProperties": false
      }
    },
    "reason": {"type": ["string", "null"]},
    "finished_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"experiment_id": {"const": "E3"}}},
      "then": {"required": ["report_evidence"]}
    },
    {
      "if": {"properties": {"experiment_id": {"const": "E7"}}},
      "then": {"required": ["child_output_path", "child_output_sha256", "source_evidence"]}
    }
  ],
  "additionalProperties": false
}
