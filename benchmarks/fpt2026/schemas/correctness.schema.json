{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpt2026.local/schemas/correctness.schema.json",
  "title": "FPT 2026 numerical correctness record",
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "type": "object",
  "required": ["schema_version", "record_type", "run_id", "correctness_record_id", "attempt_id", "sample_id", "planned_unit_id", "experiment_id", "check_id", "backend", "case_id", "vector_descriptor_sha256", "trial_seed_digest", "benchmark_key_pair_id", "oracle_id", "verified_utc", "trial_seed_index", "frame_index", "verification_kind", "requested_slot_count", "inactive_slot_count", "compared_value_count", "finite_value_count", "nonfinite_value_count", "max_abs_error", "rms_error", "max_real_error", "max_imag_error", "component_max_abs_error", "mismatch_count", "worst_index", "worst_expected", "worst_actual", "failure_reason", "transport_mismatch_count", "noncanonical_residue_count", "retained_c1_mismatch_count", "transport_passed", "threshold", "paired_reference_correctness_record_id", "pairwise_max_abs_error", "pairwise_rms_error", "passed"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "correctness"},
    "run_id": {"type": "string", "minLength": 1},
    "correctness_record_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": ["string", "null"]},
    "planned_unit_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "pattern": "^E[1-8]$"},
    "check_id": {"enum": ["C1", "C2", "FPGA-Test", "C3", "semantic", "timed-semantic", "resident-semantic"]},
    "backend": {"enum": ["fpga", "seal-embedded", "stock-seal-reference"]},
    "case_id": {"type": "string", "minLength": 1},
    "vector_descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "trial_seed_digest": {"$ref": "#/$defs/sha256"},
    "benchmark_key_pair_id": {"$ref": "#/$defs/sha256"},
    "oracle_id": {"type": "string", "minLength": 1},
    "verified_utc": {"type": "string", "format": "date-time"},
    "trial_seed_index": {"type": "integer", "minimum": 0},
    "frame_index": {"type": "integer", "minimum": 0},
    "verification_kind": {"enum": ["coefficient_exact", "decrypt_decode", "paired_reference", "negative_guard"]},
    "role": {"enum": ["NTT-A", "NTT-B", "semantic", "negative_guard"]},
    "selector": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
    "modulus": {"type": ["integer", "null"], "minimum": 2},
    "pattern": {"type": ["string", "null"]},
    "requested_slot_count": {"type": "integer", "minimum": 0, "maximum": 4096},
    "inactive_slot_count": {"type": "integer", "minimum": 0, "maximum": 4096},
    "compared_value_count": {"type": "integer", "minimum": 1},
    "finite_value_count": {"type": "integer", "minimum": 0},
    "nonfinite_value_count": {"type": "integer", "minimum": 0},
    "max_abs_error": {"type": ["number", "null"], "minimum": 0},
    "rms_error": {"type": ["number", "null"], "minimum": 0},
    "max_real_error": {"type": ["number", "null"], "minimum": 0},
    "max_imag_error": {"type": ["number", "null"], "minimum": 0},
    "component_max_abs_error": {"type": ["number", "null"], "minimum": 0},
    "mismatch_count": {"type": "integer", "minimum": 0},
    "worst_index": {"type": "integer", "minimum": 0},
    "worst_expected": {"type": "array", "items": {"type": ["number", "null"]}, "minItems": 2, "maxItems": 2},
    "worst_actual": {"type": "array", "items": {"type": ["number", "null"]}, "minItems": 2, "maxItems": 2},
    "failure_reason": {"type": ["string", "null"]},
    "transport_mismatch_count": {"type": "integer", "minimum": 0},
    "noncanonical_residue_count": {"type": "integer", "minimum": 0},
    "retained_c1_mismatch_count": {"type": "integer", "minimum": 0},
    "transport_passed": {"type": "boolean"},
    "first_mismatches": {"type": "array", "maxItems": 8, "items": {"type": "object"}},
    "expected_vector_sha256": {"$ref": "#/$defs/sha256"},
    "actual_vector_sha256": {"$ref": "#/$defs/sha256"},
    "threshold": {"type": "number", "minimum": 0},
    "paired_reference_correctness_record_id": {"type": ["string", "null"]},
    "pairwise_max_abs_error": {"type": ["number", "null"], "minimum": 0},
    "pairwise_rms_error": {"type": ["number", "null"], "minimum": 0},
    "passed": {"type": "boolean"}
  },
  "additionalProperties": false
}
