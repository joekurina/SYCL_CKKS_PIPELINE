{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpt2026.local/schemas/event.schema.json",
  "title": "FPT 2026 bounded SYCL command event",
  "type": "object",
  "required": ["schema_version", "record_type", "run_id", "event_record_id", "attempt_id", "sample_id", "phase", "frame_index", "stage", "transfer_kind", "modulus_index", "byte_count", "profiling_available", "profiling_unavailable_reason", "command_start_ns", "command_end_ns"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "sycl_event"},
    "run_id": {"type": "string", "minLength": 1},
    "event_record_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": ["string", "null"]},
    "phase": {"type": "string", "minLength": 1},
    "frame_index": {"type": "integer", "minimum": 0},
    "stage": {"enum": ["H2D", "ENTRY", "IFFT_FANOUT", "SCALE_REDUCE", "POLY_MULT_NEG_ADD", "EXIT_C0", "EXIT_NTT_A", "EXIT_NTT_B", "D2H"]},
    "transfer_kind": {"enum": ["NONE", "PACKED_INPUT", "C0", "NTT_A", "NTT_B"]},
    "modulus_index": {"type": "integer", "minimum": -1, "maximum": 5},
    "byte_count": {"type": "integer", "minimum": 0},
    "profiling_available": {"type": "boolean"},
    "profiling_unavailable_reason": {"type": ["string", "null"]},
    "command_start_ns": {"type": ["integer", "null"], "minimum": 0},
    "command_end_ns": {"type": ["integer", "null"], "minimum": 0}
  },
  "allOf": [
    {"if": {"properties": {"profiling_available": {"const": true}}}, "then": {"properties": {"profiling_unavailable_reason": {"type": "null"}, "command_start_ns": {"type": "integer"}, "command_end_ns": {"type": "integer"}}}},
    {"if": {"properties": {"profiling_available": {"const": false}}}, "then": {"properties": {"profiling_unavailable_reason": {"type": "string", "minLength": 1}}}}
  ],
  "additionalProperties": false
}
